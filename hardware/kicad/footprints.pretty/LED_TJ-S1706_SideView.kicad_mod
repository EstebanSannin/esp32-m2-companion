(footprint "LED_TJ-S1706_SideView"
	(version 20240108)
	(generator "add_led_fp")
	(layer "F.Cu")
	(descr "TOGIALED TJ-S1706 side-view LED, 1.70x0.60x1.10mm, side-emitting. Land pattern per datasheet (pads 0.80x0.70, 1.80mm c-c). v2.0 Rev A (2026-10-13): pads RENUMBERED to match the physical part (JLC engineering, GATE B3): with the lens toward the emit arrow (+y), the CATHODE is the pad at +x. Pin1=cathode (black mark) at +x, Pin2=anode at -x. Silk bar = cathode end. Rev B/v1 had the mirror image (pin 1 at -x): correct polarity came with the lens inward.")
	(tags "LED side-view TJ-S1706 0603")
	(attr smd)
	(fp_text reference "REF**" (at 0 -1.4) (layer "F.SilkS") (effects (font (size 1.0 1.0) (thickness 0.15))))
	(fp_text value "LED_TJ-S1706_SideView" (at 0 1.9) (layer "F.Fab") (effects (font (size 0.5 0.5) (thickness 0.08))))
	(fp_text user "${REFERENCE}" (at 0 0) (layer "F.Fab") (effects (font (size 0.35 0.35) (thickness 0.06))))
	(fp_rect (start -0.85 -0.30) (end 0.85 0.30) (stroke (width 0.1) (type default)) (fill none) (layer "F.Fab"))
	(fp_line (start 0.85 -0.30) (end 1.05 -0.30) (stroke (width 0.12) (type default)) (layer "F.Fab"))
	(fp_line (start 0.85 0.30) (end 1.05 0.30) (stroke (width 0.12) (type default)) (layer "F.Fab"))
	(fp_line (start 1.05 -0.30) (end 1.05 0.30) (stroke (width 0.12) (type default)) (layer "F.Fab"))
	(fp_poly (pts (xy 0.15 0.45) (xy 0.55 0.45) (xy 0.35 0.72)) (stroke (width 0) (type default)) (fill solid) (layer "F.Fab"))
	(fp_line (start 0.35 0.30) (end 0.35 0.50) (stroke (width 0.1) (type default)) (layer "F.Fab"))
	(fp_line (start 1.6 -0.4) (end 1.6 0.4) (stroke (width 0.2) (type default)) (layer "F.SilkS"))
	(fp_text user "K" (at 1.6 -0.85) (layer "F.Fab") (effects (font (size 0.35 0.35) (thickness 0.06))))
	(fp_rect (start -1.45 -0.55) (end 1.85 0.90) (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))
	(pad "1" smd roundrect (at 0.90 0) (size 0.80 0.70) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
	(pad "2" smd roundrect (at -0.90 0) (size 0.80 0.70) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
